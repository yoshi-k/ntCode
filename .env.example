# ntCode AI Coding Assistant - Environment Variables
# Copy this file to .env and fill in your values

# Required: Your Anthropic API key
ANTHROPIC_API_KEY=your_api_key_here

# Optional: Debug mode (shows detailed logging)
NTCODE_DEBUG=false

# Optional: Verbose mode (interactive tool approval)
NTCODE_VERBOSE=false

# Optional: Enable conversation logging to file
NTCODE_LOG_CONVERSATIONS=true

# Optional: Custom Claude model (advanced users)
# NTCODE_MODEL=claude-3-5-sonnet-20241022

# Optional: OpenAI-compatible endpoint settings
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3

# Optional: force a tool-calling convention instead of model-name auto-detection
# Supported values: auto, ntcode, xml, json_block, gemma
# CALLING_CONVENTION=auto
# NTCODE_CALLING_CONVENTION=auto