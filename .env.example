# ntCode AI Coding Assistant - Environment Variables
# Copy this file to .env and fill in your values

# ---------------------------------------------------------------------------
# Model provider: "anthropic" (Claude, default) or "openai" (any
# OpenAI-compatible server: llama.cpp, vLLM, Ollama, LM Studio, OpenAI, Groq)
# ---------------------------------------------------------------------------
# LLM_PROVIDER=anthropic

# Claude: your Anthropic API key, and optionally the model
ANTHROPIC_API_KEY=your_api_key_here
# NTCODE_MODEL=claude-sonnet-4-6

# OpenAI-compatible server (used when LLM_PROVIDER=openai)
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:8080/v1   # llama.cpp: start llama-server with --jinja
# OPENAI_API_KEY=none                        # local servers accept any value
# OPENAI_MODEL=your-model-name

# Tool calling for OpenAI-compatible servers.
# auto / native (default): native tool calling via the API's `tools` field.
# ntcode, xml, json_block, gemma: a text format, for servers without tool support.
# CALLING_CONVENTION=auto

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Debug mode (detailed logging to console and file)
NTCODE_DEBUG=false

# Verbose mode (approve each tool call before it runs)
NTCODE_VERBOSE=false

# Conversation logging to ntcode.log
NTCODE_LOG_CONVERSATIONS=true
