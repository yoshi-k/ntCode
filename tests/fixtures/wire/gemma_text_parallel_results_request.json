{
  "kind": "request",
  "description": "Text mode with two results: they must be merged into one user turn, because strict chat templates (Gemma, Mistral) reject consecutive user messages.",
  "profile": {
    "provider": "openai",
    "model": "gemma-4-26B-A4B-it-UD-Q8_K_XL.gguf",
    "tool_mode": "text",
    "dialect": "gemma"
  },
  "system": "You are ntCode.",
  "tools": [
    {
      "name": "read_file",
      "description": "Read a UTF-8 text file from the workspace.",
      "parameters": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "description": "Path relative to the repository root."
          }
        },
        "required": [
          "filename"
        ]
      }
    },
    {
      "name": "git_status",
      "description": "Show git status.",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "What does README.md say?"
        }
      ]
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "tool_call",
          "id": "toolu_01",
          "name": "read_file",
          "args": {
            "filename": "README.md"
          }
        },
        {
          "type": "tool_call",
          "id": "toolu_02",
          "name": "git_status",
          "args": {}
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "call_id": "toolu_01",
          "content": "# ntCode\nA small coding agent."
        },
        {
          "type": "tool_result",
          "call_id": "toolu_02",
          "content": "nothing to commit",
          "is_error": false
        }
      ]
    }
  ],
  "expect_request": {
    "path": "/v1/chat/completions",
    "body_excludes": [
      "tools"
    ],
    "properties": {
      "roles_alternate": true,
      "message_contains": [
        {
          "index": 2,
          "role": "user",
          "substring": "# ntCode"
        },
        {
          "index": 2,
          "role": "user",
          "substring": "nothing to commit"
        }
      ]
    }
  },
  "legacy_xfail": "legacy sends each tool result as its own user message"
}
