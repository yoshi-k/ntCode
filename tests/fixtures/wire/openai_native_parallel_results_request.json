{
  "kind": "request",
  "description": "One role=tool message per result, in call order; content null when the assistant sent no text.",
  "profile": {
    "provider": "openai",
    "model": "gpt-4o",
    "tool_mode": "native"
  },
  "system": "You are ntCode.",
  "tools": [
    {
      "name": "read_file",
      "description": "Read a UTF-8 text file from the workspace.",
      "parameters": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "description": "Path relative to the repository root."
          }
        },
        "required": [
          "filename"
        ]
      }
    },
    {
      "name": "git_status",
      "description": "Show git status.",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "What does README.md say?"
        }
      ]
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "tool_call",
          "id": "toolu_01",
          "name": "read_file",
          "args": {
            "filename": "README.md"
          }
        },
        {
          "type": "tool_call",
          "id": "toolu_02",
          "name": "git_status",
          "args": {}
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "call_id": "toolu_01",
          "content": "# ntCode\nA small coding agent."
        },
        {
          "type": "tool_result",
          "call_id": "toolu_02",
          "content": "nothing to commit",
          "is_error": false
        }
      ]
    }
  ],
  "expect_request": {
    "path": "/v1/chat/completions",
    "body_includes": {
      "messages": [
        {
          "role": "system",
          "content": "You are ntCode."
        },
        {
          "role": "user",
          "content": "What does README.md say?"
        },
        {
          "role": "assistant",
          "content": null,
          "tool_calls": [
            {
              "id": "toolu_01",
              "type": "function",
              "function": {
                "name": "read_file",
                "arguments": "{\"filename\": \"README.md\"}"
              }
            },
            {
              "id": "toolu_02",
              "type": "function",
              "function": {
                "name": "git_status",
                "arguments": "{}"
              }
            }
          ]
        },
        {
          "role": "tool",
          "tool_call_id": "toolu_01",
          "content": "# ntCode\nA small coding agent."
        },
        {
          "role": "tool",
          "tool_call_id": "toolu_02",
          "content": "nothing to commit"
        }
      ]
    }
  }
}
